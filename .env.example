# ── GoHighLevel ───────────────────────────────────────────────────────────────
# API Key de GHL (Settings → Integrations → API Keys en el sub-account)
GHL_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Location ID del sub-account de GHL
GHL_LOCATION_ID=xxxxxxxxxxxxxxxx

# ── Sincronización ────────────────────────────────────────────────────────────
# Expresión cron para el job automático. Default: cada 15 minutos.
# Formato: segundo minuto hora día mes díaSemana
SYNC_CRON_SCHEDULE="*/15 * * * *"

# ── Meta Ads ──────────────────────────────────────────────────────────────────
# System User Token de Meta Business (larga duración, no expira).
# Obtener en: Business Settings → System Users → Generate Token
# Permisos requeridos: ads_read, ads_management, read_insights
META_ACCESS_TOKEN=EAATVLQAhQ54BRZAQROco5mpEVrhp4ZCggmE08XPS4PzAvHWv3AAahGJTvzIETJHRW1JEpcx9Gb8i3FPeZBeq5toHvWtoxbxWqUTgKA04YSS3CzvrDpKdOfeZAYPd9gZAd64iW1PeZABwoZA7jddoqxsEzejkweKz9ncARpfYZAMDx2HUA9eINueD4h3ny5ZAw

# ID numérico de la cuenta publicitaria (sin el prefijo "act_")
# Encontrar en Ads Manager → la URL tiene ?act=XXXXXXXXXX
META_AD_ACCOUNT_ID=

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL del frontend (Next.js). Separar múltiples orígenes con coma.
CORS_ORIGIN=http://localhost:3000

# ── Tracking LP ──────────────────────────────────────────────────────────────
# URL pública del backend (usada para generar el snippet de tracking).
# En producción: la URL por la cual el backend es accesible desde internet.
# Si no se define, se infiere del request (puede fallar detrás de un proxy).
API_PUBLIC_URL=http://localhost:3001
