# =============================================================================
# VARIABLES DE ENTORNO — Backend API
# Copiar como .env y completar con valores reales.
# NUNCA commitear .env al repositorio.
# =============================================================================

# Puerto en que corre el backend (el front hace proxy a este puerto)
PORT=3001

# ── Supabase ─────────────────────────────────────────────────────────────────
# =============================================================================
# VARIABLES DE ENTORNO — Dashboard Diana (front)
# Copiar este archivo como .env.local y completar los valores reales.
# NUNCA commitear .env.local al repositorio.
# =============================================================================

# ── Supabase (públicas — se pueden exponer al browser) ─────────────────────
